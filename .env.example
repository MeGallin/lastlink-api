NODE_ENV=development
PORT=3000
JOURNEY_DATA_MODE=fixture
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Journey checks are limited per observed client address in each process.
JOURNEY_RATE_LIMIT_WINDOW_MS=60000
JOURNEY_RATE_LIMIT_MAX_REQUESTS=30
# Render's managed Cloudflare edge overwrites this single-value client address
# header. Set it only in that verified public deployment, not for local traffic.
# RATE_LIMIT_CLIENT_IP_HEADER=CF-Connecting-IP

# Provider credentials belong in the untracked .env file or deployment secret store.
# TFL_APP_KEY=
