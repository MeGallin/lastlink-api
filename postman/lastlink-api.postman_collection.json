{
  "info": {
    "name": "LastLink API foundation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Liveness contract', () => pm.expect(pm.response.json()).to.deep.equal({status: 'ok', service: 'lastlink-api'}));",
              "pm.test('Not cached', () => pm.expect(pm.response.headers.get('Cache-Control')).to.equal('no-store'));",
              "pm.test('Request id is returned', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.match(/^[0-9a-f-]{36}$/));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown route",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/missing"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('Error contract', () => pm.expect(pm.response.json()).to.deep.equal({error: {code: 'NOT_FOUND', message: 'Route not found'}}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Readiness",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Readiness contract', () => pm.expect(pm.response.json()).to.deep.equal({status: 'ready', service: 'lastlink-api', dataMode: pm.variables.get('expectedDataMode')}));",
              "pm.test('Not cached', () => pm.expect(pm.response.headers.get('Cache-Control')).to.equal('no-store'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unsupported health method",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Health CORS",
      "request": {
        "method": "GET",
        "header": [{ "key": "Origin", "value": "{{clientOrigin}}" }],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Allowed origin is echoed', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.equal(pm.variables.get('clientOrigin')));",
              "pm.test('Origin is varied', () => pm.expect(pm.response.headers.all().filter((header) => header.key.toLowerCase() === 'vary').some((header) => header.value.split(/[\\s,]+/).includes('Origin'))).to.equal(true));",
              "pm.test('Request id is exposed', () => pm.expect(pm.response.headers.get('Access-Control-Expose-Headers')).to.include('X-Request-Id'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Journey CORS preflight",
      "request": {
        "method": "OPTIONS",
        "header": [
          { "key": "Origin", "value": "{{clientOrigin}}" },
          { "key": "Access-Control-Request-Method", "value": "POST" },
          { "key": "Access-Control-Request-Headers", "value": "Content-Type" }
        ],
        "url": "{{baseUrl}}/api/v1/journey-check"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
              "pm.test('Preflight origin is echoed', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.equal(pm.variables.get('clientOrigin')));",
              "pm.test('POST is allowed', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('POST'));",
              "pm.test('JSON header is allowed', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Headers')).to.include('Content-Type'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Blocked CORS origin",
      "request": {
        "method": "GET",
        "header": [{ "key": "Origin", "value": "{{blockedOrigin}}" }],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
              "pm.test('Blocked origin error', () => pm.expect(pm.response.json()).to.deep.equal({error: {code: 'CORS_ORIGIN_NOT_ALLOWED', message: 'Origin not allowed'}}));",
              "pm.test('No allow header', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.equal(undefined));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "clientOrigin", "value": "http://localhost:5173" },
    { "key": "blockedOrigin", "value": "https://blocked.example.test" },
    { "key": "expectedDataMode", "value": "fixture" }
  ]
}
